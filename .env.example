# General Settings
PROJECT_NAME="Healthcare Data Operations Platform"
ENV=development
DEBUG=true

# Database — local or AWS RDS, no code change needed
# Local:  postgresql://username:password@localhost:5432/healthcare_db
# AWS RDS: postgresql://username:password@<RDS_ENDPOINT>:5432/healthcare_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/healthcare_db

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT — use a strong random secret in production (e.g. openssl rand -hex 32)
JWT_SECRET_KEY=change-this-to-a-strong-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# AI/ML & RAG
OPENAI_API_KEY=your-openai-key-here
GEMINI_API_KEY=your-gemini-key-here
VECTOR_STORE_PATH=rag/vector_store_db

# ML Service
ML_MODEL_PATH=ml/models
